          "datasource": {
            "type": "influxdb",
            "uid": "influx-sparkplug"
          },
          "query": "from(bucket: \"sparkplug\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"order\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"order_id\", \"lot_id\", \"customer\", \"qty\", \"price\", \"scrap_eur\", \"margin_eur\", \"margin_pct\", \"duration_min\"])\n  |> sort(columns: [\"_time\"], desc: true)"
        }
