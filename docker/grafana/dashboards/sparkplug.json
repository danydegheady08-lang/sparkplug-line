    {
      "id": 13,
      "type": "table",
      "title": "Finished customer orders",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-sparkplug"
      },
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
