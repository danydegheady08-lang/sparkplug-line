        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-sparkplug"
          },
          "query": "from(bucket: \"sparkplug\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"line\" and r._field == \"state\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"Line SP1\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "Productive": {
                  "color": "green",
                  "index": 0
                },
                "Standby": {
                  "color": "yellow",
                  "index": 1
                },
                "Unscheduled Downtime": {
                  "color": "red",
                  "index": 2
                },
                "Scheduled Downtime": {
                  "color": "blue",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#808080",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
