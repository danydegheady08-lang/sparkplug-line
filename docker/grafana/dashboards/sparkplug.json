    {
      "id": 10,
      "type": "timeseries",
      "title": "Electrode gap at final QC (limits 0.75 / 0.85 mm)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-sparkplug"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-sparkplug"
          },
          "query": "from(bucket: \"sparkplug\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gap\" and r._field == \"gap_mm\")\n  |> keep(columns: [\"_time\", \"_value\", \"result\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: mm",
          "decimals": 2,
          "min": 0.6,
          "max": 1.0,
          "custom": {
            "drawStyle": "points",
            "pointSize": 3,
            "showPoints": "always",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#5B8DEF"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${__field.labels.result}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fail"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pass"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5B8DEF"
                }
              }
            ]
