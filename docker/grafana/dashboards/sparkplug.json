    {
      "id": 11,
      "type": "barchart",
      "title": "Why plugs are rejected (count by reason)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-sparkplug"
      },
      "gridPos": {
        "x": 14,
        "y": 9,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-sparkplug"
          },
          "query": "from(bucket: \"sparkplug\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"reject\" and r._field == \"count\")\n  |> group(columns: [\"reason\"])\n  |> sum()\n  |> group()\n  |> keep(columns: [\"reason\", \"_value\"])\n  |> rename(columns: {_value: \"Rejects\"})\n  |> sort(columns: [\"Rejects\"], desc: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#C9A96E"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Rejects"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "reason",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "barWidth": 0.7
      }
    },
