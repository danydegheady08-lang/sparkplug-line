    {
      "id": 8,
      "type": "state-timeline",
      "title": "Line state (E10)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-sparkplug"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
