        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"sparkplug\", tag: \"station\", predicate: (r) => r._measurement == \"station\", start: -30d)",
        "definition": "station tag values",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
